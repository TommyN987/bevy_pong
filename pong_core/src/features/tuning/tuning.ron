// bevy_pong tuning (spec 1.4.8). Embedded in the binary; the single source of
// truth for every number the simulation, AI, and menus use. Units are arena
// units (the arena is 160 by 90) and seconds; angles are degrees.
// Every value is range-checked at load; a bad value names itself in the log.
(
    arena: (width: 160.0, height: 90.0),

    paddle: (
        height_min: 8.0,
        height_max: 30.0,
        height_default: 14.0,
        thickness: 2.0,
        speed: 90.0,
        inset: 4.0,
    ),

    ball: (
        radius: 1.0,
        serve_speed: 80.0,
        speed_cap: 250.0,
        // A flight longer than this is a fault: the rally restarts (M2 spec 2.5.6).
        // Classic's slowest crossing takes under four seconds.
        flight_limit_seconds: 20.0,
        max_deflection_degrees: 60.0,
        serve_cone_degrees: 30.0,
    ),

    // A mode is data (M2 spec 2.1.1). `always` effects are on from the first
    // serve; `bag` effects join one by one as the leader's progress toward the
    // points target passes each threshold, and rotate every so many points.
    // Effects are named as in the save files. Chaos's per-hit increase must be
    // below Classic's.
    modes: (
        classic: (
            per_hit_increase: 7.0,
            always: [speed],
            bag: [],
            thresholds_percent: [],
            rotate_every_points: 1,
        ),
        chaos: (
            per_hit_increase: 3.0,
            always: [speed],
            bag: [shrink],
            thresholds_percent: [30, 70],
            rotate_every_points: 1,
        ),
    ),

    // Each effect's dial rides the rally's return count: it starts to move at
    // one return and is full at another.
    effects: (
        // Both paddles shorten from height_default to height_min.
        shrink: (starts_at_return: 3, full_at_return: 15),
    ),

    match_flow: (
        countdown_seconds: 3.0,
        point_pause_seconds: 0.8,
        points_to_win_options: [5, 10, 15, 21],
        points_to_win_default: 10,
    ),

    // Stars in the menu: one, two, three. Delay is how long the AI waits after
    // the ball turns toward it; error is the spread added to its predicted target.
    // The delay is what makes a star beatable by play: under about 0.18 the
    // paddle reaches every ball at the speed cap, however it is placed. The
    // error only rolls dice, and only once it exceeds the paddle's reach of 8.
    ai: (
        one_star: (reaction_delay_seconds: 0.35, prediction_error: 12.0),
        two_stars: (reaction_delay_seconds: 0.29, prediction_error: 7.0),
        three_stars: (reaction_delay_seconds: 0.24, prediction_error: 3.0),
    ),

    // Key names are Bevy `KeyCode` variants. Escape is global and not bound here.
    bindings: (
        left: (up: KeyW, down: KeyS, action: KeyD, back: KeyA),
        right: (up: ArrowUp, down: ArrowDown, action: ArrowRight, back: ArrowLeft),
    ),

    // Profile colors, sRGB, in menu order. Profiles store the color, not the index.
    palette: [
        (red: 1.00, green: 0.30, blue: 0.25),
        (red: 1.00, green: 0.60, blue: 0.10),
        (red: 1.00, green: 0.90, blue: 0.20),
        (red: 0.30, green: 0.90, blue: 0.30),
        (red: 0.20, green: 0.80, blue: 0.90),
        (red: 0.25, green: 0.45, blue: 1.00),
        (red: 0.70, green: 0.35, blue: 1.00),
        (red: 1.00, green: 0.45, blue: 0.80),
    ],
)
